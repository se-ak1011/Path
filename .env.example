# Example environment variables for local development
# Copy this file to `.env` and fill with real values.

# Supabase public URL and publishable (anon) key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI key used by the Supabase Edge Function (ai-notes).
# NEVER hardcode this in the app — set it as a Supabase function secret:
#   supabase secrets set OPENAI_API_KEY=sk-...
OPENAI_API_KEY=

# Expo token for CI (optional; set as a Codemagic/GitHub secret)
EXPO_TOKEN=
